#: nimble-woo-sk-cz-functions/includes/features/class-gdpr-checkbox.php:70
#: nimble-woo-sk-cz-functions/includes/features/class-gdpr-checkbox.php:75
msgid "I have read the privacy policy and agree with it."
msgstr "Přečetl/a jsem si zásady ochrany osobních údajů a souhlasím s nimi."

#: nimble-woo-sk-cz-functions/includes/features/class-gdpr-checkbox.php:87
msgid "You must agree with the privacy policy to complete the order."
msgstr ""
"Pro dokončení objednávky je nutný váš souhlas se zásadami ochrany osobních "
"údajů."

#: nimble-woo-sk-cz-functions/includes/features/class-gdpr-checkbox.php:119
msgid "Privacy Policy"
msgstr "Zásady ochrany osobních údajů"

#: nimble-woo-sk-cz-functions/includes/features/class-remove-additional-information-tab.php:104
msgid "Additional information"
msgstr "Další informace"
