#: woocommerce-sk-cz-functions/includes/features/class-company-checkout-fields.php:299
msgid "Please enter the company name."
msgstr "Vyplňte názov firmy."

#: woocommerce-sk-cz-functions/includes/features/class-company-checkout-fields.php:267
#: woocommerce-sk-cz-functions/includes/features/class-company-checkout-fields.php:303
msgid "Please enter Company ID."
