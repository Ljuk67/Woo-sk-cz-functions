#: woocommerce-sk-cz-functions/includes/features/class-company-checkout-fields.php:307
msgid "Please enter Tax ID."
msgstr "Vyplňte DIČ."

#: woocommerce-sk-cz-functions/includes/features/class-company-checkout-fields.php:358
msgid "Company data"
msgstr "Firemné údaje"

#: woocommerce-sk-cz-functions/includes/features/class-company-checkout-fields.php:361
