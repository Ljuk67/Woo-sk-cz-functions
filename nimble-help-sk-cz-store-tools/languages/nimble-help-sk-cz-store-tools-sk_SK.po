#: nimble-help-sk-cz-store-tools/includes/class-plugin.php:48
msgid "Settings"
msgstr "Nastavenia"

#: nimble-help-sk-cz-store-tools/includes/class-plugin.php:123
msgid ""
"Nimble.help - SK/CZ Store Tools for WooCommerce requires the WooCommerce "
"plugin to be active."
msgstr ""
"Nimble.help - SK/CZ Store Tools for WooCommerce vyžaduje aktívny plugin "
"WooCommerce."

#: nimble-help-sk-cz-store-tools/includes/class-settings.php:83
msgid "Place order with payment obligation"
msgstr "Objednať s povinnosťou platby"

#: nimble-help-sk-cz-store-tools/includes/class-settings.php:101
msgid "Cash on delivery fee"
msgstr "Poplatok za dobierku"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:32
#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:129
msgid "Nimble Woo SK/CZ"
msgstr "Nimble Woo SK/CZ"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:90
msgid "Plugin support and rating links"
msgstr "Podpora pluginu a odkazy na hodnotenie"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:93
msgid "Custom solutions"
msgstr "Vývoj na mieru"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:94
msgid ""
"Need a custom plugin, theme adjustments, or specific features? I create "
"custom WordPress solutions for your needs."
msgstr ""
"Potrebujete vlastný doplnok, úpravy tém alebo špecifické funkcie? Vytváram "
"riešenia WordPress na mieru pre vaše potreby."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:95
msgid "Fast & reliable websites for businesses that need things done properly"
msgstr ""
"Rýchle a spoľahlivé weby pre ľudí a firmy, ktoré potrebujú veci spravené "
"poriadne"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:96
msgid "Ask about your website"
msgstr "Opýtajte sa na svoj web"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:101
msgid "Like this plugin? Please rate it on WordPress.org."
msgstr "Páči sa vám tento plugin? Ohodnoťte ho na WordPress.org."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:102
msgid "Rate this plugin"
msgstr "Ohodnotiť plugin"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:134
msgid "Checkout button text"
msgstr "Text tlačidla v pokladni"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:135
msgid ""
"Leave the predefined text unchanged to use the translated default for the "
"current site language. Clear the field to return to the default after saving "
"custom text."
msgstr ""
"Nechajte predvyplnený text bez zmeny, aby sa použil preložený predvolený "
"text pre aktuálny jazyk stránky. Vymažte pole, ak sa po uložení vlastného "
"textu chcete vrátiť k predvolenému textu."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:144
msgid "Enable company checkout fields"
msgstr "Povoliť \"Nákup na firmu\" v pokladni"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:145
msgid "Adds company purchase checkbox and business fields at checkout."
msgstr "Pridá checkbox nákupu na firmu a firemné polia v pokladni."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:153
msgid "Enable GDPR checkbox in checkout"
msgstr "Povoliť GDPR checkbox v pokladni"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:162
msgid "Enable child category row on archives"
msgstr "Povoliť riadok podradených kategórií v archívoch"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:171
msgid "Hide paid shipping when free shipping exists"
msgstr "Skryť platené možnosti  dopravy, keď je k dispozícii doprava zdarma"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:172
msgid "Shows only free shipping rates when free shipping is available."
msgstr ""
"Schová platené možnosti dopravy a zobrazí iba dopravu zdarma, keď je doprava "
"zdarma dostupná."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:180
msgid "Hide Additional Information tab on products"
msgstr "Skryť kartu Ďalšie informácie na produktoch"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:181
msgid "Removes the Additional Information tab from single product pages."
msgstr "Odstráni kartu Ďalšie informácie na stránkach jednotlivých produktov."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:190
msgid ""
"When enabled, show the hidden Additional Information content directly in the "
"long product description instead of hiding it completely."
msgstr ""
"Ak je povolené, skrytý obsah karty Ďalšie informácie sa zobrazí priamo v "
"dlhom popise produktu namiesto úplného skrytia."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:198
msgid "Enable COD fee"
msgstr "Povoliť poplatok za dobierku"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:199
msgid ""
"Adds an extra fee when the customer selects the Cash on Delivery payment "
"gateway."
msgstr "Pridá extra poplatok, keď zákazník zvolí platobnú bránu Dobierka."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:207
msgid "Default COD fee amount"
msgstr "Predvolená výška poplatku za dobierku"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:208
msgid ""
"Used when no configured cart-total band matches. Based on cart total after "
"shipping, tax, and coupons."
msgstr ""
"Použije sa, keď sa nezhoduje žiadne nakonfigurované pásmo sumy košíka. "
"Vychádza z celkovej sumy košíka po doprave, dani a kupónoch."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:217
msgid "COD fee label"
msgstr "Názov poplatku za dobierku"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:218
msgid "Frontend fee label. Leave empty to use the default plugin label."
msgstr ""
"Názov poplatku zobrazený zákazníkovi. Nechajte prázdne pre predvolený názov "
"pluginu."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:284
msgid "Not ready yet."
msgstr "Zatiaľ nie je pripravené."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:297
msgid ""
"Classic checkout only: Adds a required privacy-policy consent checkbox at "
"checkout."
msgstr ""
"Len pre klasický checkout: Pridá povinný checkbox súhlasu so zásadami "
"ochrany osobných údajov v pokladni."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:298
msgid ""
"In block checkout, the GDPR checkbox is combined with the terms-and-"
"conditions checkbox."
msgstr "V blokovej pokladni je GDPR checkbox spojený s VOP checkboxom v jednom"

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:314
msgid ""
"Displays clickable, responsive boxes for child categories above products on "
"category archive pages."
msgstr ""
"Zobrazí klikateľné, responzívne boxy pre podradené kategórie nad produktmi "
"na stránkach archívov kategórií."

#: nimble-help-sk-cz-store-tools/includes/class-wc-settings-tab.php:324
msgid "Child category row preview"
msgstr "Náhľad riadka podradených kategórií"

#: nimble-help-sk-cz-store-tools/includes/features/class-company-checkout-fields.php:61
